{
  "routes": [
    {
      "src": "^/(index\\.html)?$",
      "dest": "/maintenance.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" }
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/maintenance.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store" }
    }
  ]
}
